{
  "version": 2,
  "buildCommand": "pnpm vercel-build",
  "outputDirectory": "dist",
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/manifest.json", "dest": "/manifest.json" },
    { "src": "/config.json", "dest": "/config.json" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
